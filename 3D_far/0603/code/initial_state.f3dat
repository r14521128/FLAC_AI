; ===========================================================
; initial_state.f3dat  (0603)
; Mohr-Coulomb 材料(含 tension) + 邊界 + 初始應力
; 幾何沿用 0601 的 step5_tunnel_marked；存到 0603。
; ===========================================================

model restore 'D:/FLAC_AI/3D_far/0601/step5_tunnel_marked'

; ===========================================================
; Mohr-Coulomb 材料 (density young poisson cohesion friction tension)
; tension = cohesion x 0.1 (placeholder，待岩石試驗 σt 取代)
; ===========================================================
zone cmodel assign mohr-coulomb range group 'SS_NK' slot 'lithology'
zone property density 2565.0 young 1.2e9 poisson 0.29 cohesion 300e3 friction 38 tension 30e3 range group 'SS_NK' slot 'lithology'

zone cmodel assign mohr-coulomb range group 'Interbedded_ST' slot 'lithology'
zone property density 2520.0 young 0.6e9 poisson 0.32 cohesion 75e3 friction 35 tension 7.5e3 range group 'Interbedded_ST' slot 'lithology'

zone cmodel assign mohr-coulomb range group 'SH_ST' slot 'lithology'
zone property density 2538.0 young 0.8e9 poisson 0.38 cohesion 100e3 friction 32 tension 10e3 range group 'SH_ST' slot 'lithology'

zone cmodel assign mohr-coulomb range group 'SS_NC' slot 'lithology'
zone property density 2485.0 young 1.0e9 poisson 0.25 cohesion 200e3 friction 42 tension 20e3 range group 'SS_NC' slot 'lithology'

zone cmodel assign mohr-coulomb range group 'Fault' slot 'lithology'
zone property density 2490.0 young 0.3e9 poisson 0.30 cohesion 30e3 friction 20 tension 3e3 range group 'Fault' slot 'lithology'

; tunnel 依 x 分段 (2500-2600 SS_NC, 2600-2850 Fault, 2850-3000 SH_ST)
zone cmodel assign mohr-coulomb range group 'tunnel' position-x 2500 2600
zone property density 2485.0 young 1.0e9 poisson 0.25 cohesion 200e3 friction 42 tension 20e3 range group 'tunnel' position-x 2500 2600

zone cmodel assign mohr-coulomb range group 'tunnel' position-x 2600 2850
zone property density 2490.0 young 0.3e9 poisson 0.30 cohesion 30e3 friction 20 tension 3e3 range group 'tunnel' position-x 2600 2850

zone cmodel assign mohr-coulomb range group 'tunnel' position-x 2850 3000
zone property density 2538.0 young 0.8e9 poisson 0.38 cohesion 100e3 friction 32 tension 10e3 range group 'tunnel' position-x 2850 3000

; ===========================================================
; 材料檢核
; ===========================================================
fish define check_material
    local n_no_model = 0
    local n_no_den   = 0
    loop foreach local z zone.list
        if zone.model(z) = 'null' then
            continue
        endif
        if zone.model(z) = 'none' then
            n_no_model = n_no_model + 1
            continue
        endif
        if zone.density(z) = 0.0 then
            n_no_den = n_no_den + 1
        endif
    endloop
    io.out('zones with no model : ' + string(n_no_model))
    io.out('zones with density=0: ' + string(n_no_den))
end
@check_material

; ===========================================================
; 邊界條件
; ===========================================================
zone gridpoint fix velocity-x range position-x 2499 2501
zone gridpoint fix velocity-x range position-x 2999 3001
zone gridpoint fix velocity-y range position-y 4699 4701
zone gridpoint fix velocity-y range position-y 4899 4901
zone gridpoint fix velocity-z range position-z 169  171

; ===========================================================
; 重力 + 初始應力 (K0 = 1.2)
; ===========================================================
model gravity 0 0 -9.81
zone initialize-stresses ratio 1.2 1.2

; ===========================================================
; 彈性解 -> 歸零位移
; ===========================================================
model solve elastic
zone gridpoint initialize velocity (0,0,0)
zone gridpoint initialize displacement (0,0,0)

; ===========================================================
; 存檔
; ===========================================================
model save 'D:/FLAC_AI/3D_far/0603/initial_state_0603'

program quit
