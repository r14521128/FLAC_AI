; ===========================================================
; diag_box_yield.f3dat  (0603, diagnostic, ASCII only)
; Is the submodel box region (z 192..242) clean?
;   - per-lithology total + tension-yield INSIDE each box
;   - z-range of SS_NK / Interbedded_ST (confirm surface skin?)
;   - location of most-compressive szz
; box 2608: x 2558..2658 ; box 2896: x 2846..2946 ; both y 4775..4825 z 192..242
; tension = and(state,12) != 0
; ===========================================================
model new
program log-file 'D:/FLAC_AI/3D_far/0603/out/diag_box_yield.log'
program log on
model restore 'D:/FLAC_AI/3D_far/0603/initial_state_0603'

[global G = array.create(5)]
fish define set_names
    G(1) = 'SS_NK'
    G(2) = 'Interbedded_ST'
    G(3) = 'SH_ST'
    G(4) = 'SS_NC'
    G(5) = 'Fault'
end
@set_names

[global b1_tot = array.create(5)]
[global b1_ten = array.create(5)]
[global b2_tot = array.create(5)]
[global b2_ten = array.create(5)]
[global znk_min =  1e30]
[global znk_max = -1e30]
[global zib_min =  1e30]
[global zib_max = -1e30]
[global szzmin =  1e30]
[global szzmin_z = 0.0]

fish define gidx(nm)
    gidx = 0
    local k
    loop k (1, 5)
        if nm = G(k)
            gidx = k
        endif
    endloop
end

fish define in_box(xx, yy, zz, xlo, xhi)
    in_box = 0
    if xx >= xlo
        if xx <= xhi
            if yy >= 4775.0
                if yy <= 4825.0
                    if zz >= 192.0
                        if zz <= 242.0
                            in_box = 1
                        endif
                    endif
                endif
            endif
        endif
    endif
end

fish define run_box
    local k
    loop k (1, 5)
        b1_tot(k) = 0
        b1_ten(k) = 0
        b2_tot(k) = 0
        b2_ten(k) = 0
    endloop
    loop foreach local z zone.list
        if zone.model(z) # 'null'
            local xx = zone.pos.x(z)
            local yy = zone.pos.y(z)
            local zz = zone.pos.z(z)
            local szz = zone.stress.zz(z)
            if szz < szzmin
                szzmin = szz
                szzmin_z = zz
            endif
            local gi = gidx(zone.group(z,'lithology'))
            if gi = 1
                if zz < znk_min
                    znk_min = zz
                endif
                if zz > znk_max
                    znk_max = zz
                endif
            endif
            if gi = 2
                if zz < zib_min
                    zib_min = zz
                endif
                if zz > zib_max
                    zib_max = zz
                endif
            endif
            if gi > 0
                local ten = 0
                if math.and(zone.state(z,1), 12) # 0
                    ten = 1
                endif
                if in_box(xx, yy, zz, 2558.0, 2658.0) = 1
                    b1_tot(gi) = b1_tot(gi) + 1
                    b1_ten(gi) = b1_ten(gi) + ten
                endif
                if in_box(xx, yy, zz, 2846.0, 2946.0) = 1
                    b2_tot(gi) = b2_tot(gi) + 1
                    b2_ten(gi) = b2_ten(gi) + ten
                endif
            endif
        endif
    endloop
    io.out('=== BOX 2608 (x2558-2658,z192-242) yield by lithology ===')
    loop k (1, 5)
        io.out(G(k) + '  tot=' + string(b1_tot(k)) + '  tension=' + string(b1_ten(k)))
    endloop
    io.out('=== BOX 2896 (x2846-2946,z192-242) yield by lithology ===')
    loop k (1, 5)
        io.out(G(k) + '  tot=' + string(b2_tot(k)) + '  tension=' + string(b2_ten(k)))
    endloop
    io.out('=== SS_NK z-range = ' + string(znk_min) + ' .. ' + string(znk_max))
    io.out('=== Interbedded_ST z-range = ' + string(zib_min) + ' .. ' + string(zib_max))
    io.out('=== most-compressive szz = ' + string(szzmin) + ' at z=' + string(szzmin_z))
end
@run_box

program echo-line '=== DIAG BOX DONE ==='
program quit
