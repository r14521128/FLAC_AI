flac3d>[global ndisp = 0]
flac3d>
flac3d>fish define ReadBoundaryDisp
   Def>    local fl = array.create(1)
   Def>    local st = file.open(disp_file, 0, 1)
   Def>    if st # 0 then
   Def>        io.out('[WARN] cannot open disp file: ' + disp_file)
   Def>        ndisp = 0
   Def>        exit
   Def>    endif
   Def>    ; ---- pass 1:  box  max step_pair(mp)  max cycle(mc) ----
   Def>    st = file.read(fl, 1)          ; header
   Def>    local mp = -1.0
   Def>    local mc = -1.0
   Def>    st = file.read(fl, 1)
   Def>    loop while st = 0
   Def>        local ln = fl(1)
   Def>        if string.token(ln, 11) = box_tag then
   Def>            local sp = float(string.token(ln, 1))
   Def>            local cy = float(string.token(ln, 3))
   Def>            if sp > mp then
   Def>                mp = sp
   Def>                mc = cy
   Def>            else
   Def>                if sp = mp then
   Def>                    if cy > mc then
   Def>                        mc = cy
   Def>                    endif
   Def>                endif
   Def>            endif
   Def>        endif
   Def>        st = file.read(fl, 1)
   Def>    endloop
   Def>    st = file.close
   Def>    global disp_mp = mp
   Def>    global disp_mc = mc
   Def>
   Def>    ; ---- pass 2:  (box, mp, mc)  ----
   Def>    st = file.open(disp_file, 0, 1)
   Def>    st = file.read(fl, 1)
   Def>    local cnt = 0
   Def>    st = file.read(fl, 1)
   Def>    loop while st = 0
   Def>        local ln2 = fl(1)
   Def>        if string.token(ln2, 11) = box_tag then
   Def>            if float(string.token(ln2, 1)) = mp then
   Def>                if float(string.token(ln2, 3)) = mc then
   Def>                    cnt = cnt + 1
   Def>                endif
   Def>            endif
   Def>        endif
   Def>        st = file.read(fl, 1)
   Def>    endloop
   Def>    st = file.close
   Def>    ndisp = cnt
   Def>    if cnt = 0 then
   Def>        io.out('[WARN] no boundary disp rows for ' + box_tag)
   Def>        exit
   Def>    endif
   Def>    global dxdat  = array.create(cnt)
   Def>    global dydat  = array.create(cnt)
   Def>    global dzdat  = array.create(cnt)
   Def>    global duxdat = array.create(cnt)
   Def>    global duydat = array.create(cnt)
   Def>    global duzdat = array.create(cnt)
   Def>
   Def>    ; ---- pass 3:  ----
   Def>    st = file.open(disp_file, 0, 1)
   Def>    st = file.read(fl, 1)
   Def>    local i = 0
   Def>    st = file.read(fl, 1)
   Def>    loop while st = 0
   Def>        local ln3 = fl(1)
   Def>        if string.token(ln3, 11) = box_tag then
   Def>            if float(string.token(ln3, 1)) = mp then
   Def>                if float(string.token(ln3, 3)) = mc then
   Def>                    i = i + 1
   Def>                    dxdat(i)  = float(string.token(ln3, 17))
   Def>                    dydat(i)  = float(string.token(ln3, 18))
   Def>                    dzdat(i)  = float(string.token(ln3, 19))
   Def>                    duxdat(i) = float(string.token(ln3, 20))
   Def>                    duydat(i) = float(string.token(ln3, 21))
   Def>                    duzdat(i) = float(string.token(ln3, 22))
   Def>                endif
   Def>            endif
   Def>        endif
   Def>        st = file.read(fl, 1)
   Def>    endloop
   Def>    st = file.close
   Def>    io.out('boundary disp loaded for ' + box_tag + ': ' + string(i) + ' rows (mp=' + string(mp) + ' mc=' + string(mc) + ')')
   Def>end
