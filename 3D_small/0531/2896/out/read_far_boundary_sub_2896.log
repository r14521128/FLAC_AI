flac3d>fish define MapDispToBoundary
   Def>    if ndisp = 0 then
   Def>        io.out('[WARN] no boundary disp data; skip displacement mapping')
   Def>        exit
   Def>    endif
   Def>    local sr = 4.0
   Def>    local sr2 = sr * sr
   Def>    local nset = 0
   Def>    loop foreach local g gp.list
   Def>        local gx = gp.pos.x(g)
   Def>        local gy = gp.pos.y(g)
   Def>        local gz = gp.pos.z(g)
   Def>        local onface = 0
   Def>        if math.abs(gx - box_xmin) <= face_tol then
   Def>            onface = 1
   Def>        endif
   Def>        if math.abs(gx - box_xmax) <= face_tol then
   Def>            onface = 1
   Def>        endif
   Def>        if math.abs(gy - box_ymin) <= face_tol then
   Def>            onface = 1
   Def>        endif
   Def>        if math.abs(gy - box_ymax) <= face_tol then
   Def>            onface = 1
   Def>        endif
   Def>        if math.abs(gz - box_zmin) <= face_tol then
   Def>            onface = 1
   Def>        endif
   Def>        if math.abs(gz - box_zmax) <= face_tol then
   Def>            onface = 1
   Def>        endif
   Def>        if onface = 1 then
   Def>            local sw = 0.0
   Def>            local sux = 0.0
   Def>            local suy = 0.0
   Def>            local suz = 0.0
   Def>            local dmin = 1.0e30
   Def>            local inear = 1
   Def>            loop local p (1, ndisp)
   Def>                local ddx = gx - dxdat(p)
   Def>                local ddy = gy - dydat(p)
   Def>                local ddz = gz - dzdat(p)
   Def>                local d2 = ddx * ddx + ddy * ddy + ddz * ddz
   Def>                if d2 < dmin then
   Def>                    dmin = d2
   Def>                    inear = p
   Def>                endif
   Def>                if d2 <= sr2 then
   Def>                    if d2 < 1.0e-10 then
   Def>                        d2 = 1.0e-10
   Def>                    endif
   Def>                    local w = 1.0 / d2
   Def>                    sw  = sw  + w
   Def>                    sux = sux + duxdat(p) * w
   Def>                    suy = suy + duydat(p) * w
   Def>                    suz = suz + duzdat(p) * w
   Def>                endif
   Def>            endloop
   Def>            local ux = 0.0
   Def>            local uy = 0.0
   Def>            local uz = 0.0
   Def>            if sw > 0.0 then
   Def>                ux = sux / sw
   Def>                uy = suy / sw
   Def>                uz = suz / sw
   Def>            else
   Def>                ux = duxdat(inear)
   Def>                uy = duydat(inear)
   Def>                uz = duzdat(inear)
   Def>            endif
   Def>            gp.disp.x(g) = ux
   Def>            gp.disp.y(g) = uy
   Def>            gp.disp.z(g) = uz
   Def>            gp.extra(g, 1) = ux
   Def>            gp.extra(g, 2) = uy
   Def>            gp.extra(g, 3) = uz
   Def>            nset = nset + 1
   Def>        endif
   Def>    endloop
   Def>    io.out('boundary gp displacement set: ' + string(nset))
   Def>end
flac3d>@MapDispToBoundary
