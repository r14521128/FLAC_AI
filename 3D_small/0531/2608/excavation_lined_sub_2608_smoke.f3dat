; ============================================================
; excavation_lined_sub_2608_smoke.f3dat
; SMOKE test (SMOKE_CAP=4) for sub_2608 lined excavation.
; Separate outputs so it never overwrites the full lined run.
; ASCII-only comments for FLAC3D console safety.
; ============================================================

model new
program log-file 'D:/FLAC_AI/3D_small/0531/2608/out/excavation_lined_sub_2608_smoke.log'
program log on

; ---- restore FIRST (model restore wipes FISH globals set before it) ----
[global RESTORE_NAME = 'D:/FLAC_AI/3D_small/0531/2608/sub_2608_initial_state']
model restore [RESTORE_NAME]

; ---- run-specific globals set AFTER restore so they survive ----
[global MODEL_ID = 'sub_2608']
[global CSV_PATH = 'D:/FLAC_AI/3D_small/0531/2608/out/smoke_lined_monitor_sub_2608.csv']
[global FINAL_SAVE = 'D:/FLAC_AI/3D_small/0531/2608/out/sub_2608_lined_smoke']
[global MONITOR_X = 2608.0]
[global SMOKE_CAP = 4]
[global USE_LINER = 1]

call 'D:/FLAC_AI/3D_small/0531/excavation_lined_core.f3dat' suppress
