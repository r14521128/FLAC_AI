; ---- geology STL ----
geometry import 'D:/FLAC_AI/3D_small/0531/SH with thin SS_(ST).stl'
geometry import 'D:/FLAC_AI/3D_small/0531/SS_SH Interbedded_(ST).stl'
geometry import 'D:/FLAC_AI/3D_small/0531/SS with minor SH_(NK).stl'

zone group 'SS_NK' slot 'lithology'
zone group 'Interbedded_ST' slot 'lithology' ...
    range geometry-space 'SS with minor SH_(NK)' count odd direction (0,0,1)
zone group 'SH_ST' slot 'lithology' ...
    range geometry-space 'SS_SH Interbedded_(ST)' count odd direction (0,0,1)
zone group 'SS_NC' slot 'lithology' ...
    range geometry-space 'SH with thin SS_(ST)' count odd direction (0,0,1)
zone group 'Fault' slot 'lithology' ...
    range geometry-distance 'SH with thin SS_(ST)' gap 30 ...
    group 'SS_NC' slot 'lithology'
zone group 'Fault' slot 'lithology' ...
    range geometry-distance 'SH with thin SS_(ST)' gap 15 ...
    group 'SH_ST' slot 'lithology'

fish define count_lith
    local n_nk = 0
    local n_int = 0
    local n_sh = 0
    local n_nc = 0
    local n_fa = 0
    loop foreach local z zone.list
        local g = zone.group(z, 'lithology')
        if g = 'SS_NK' then
            n_nk = n_nk + 1
        end_if
        if g = 'Interbedded_ST' then
            n_int = n_int + 1
        end_if
        if g = 'SH_ST' then
            n_sh = n_sh + 1
        end_if
        if g = 'SS_NC' then
            n_nc = n_nc + 1
        end_if
        if g = 'Fault' then
            n_fa = n_fa + 1
        end_if
    end_loop
    ii = io.out('SS_NK: ' + string(n_nk))
    ii = io.out('Interbedded_ST: ' + string(n_int))
    ii = io.out('SH_ST: ' + string(n_sh))
    ii = io.out('SS_NC: ' + string(n_nc))
    ii = io.out('Fault: ' + string(n_fa))
end
@count_lith

; ---- tunnel ----
[tun_y_c  = 4800.0]
[tun_z_sp = 217.0]
[tun_z_in = 214.5]
[tun_R    = 3.0]
[tun_BH   = 3.0]

fish define mark_tunnel
    local n_marked = 0
    loop foreach local z zone.list
        local cy = zone.pos.y(z)
        local cz = zone.pos.z(z)
        if cz < tun_z_in then
            continue
        end_if
        local in_tun = 0
        if cz >= tun_z_sp then
            local dy = cy - tun_y_c
            local dz = cz - tun_z_sp
            if (dy*dy + dz*dz) <= (tun_R * tun_R) then
                in_tun = 1
            end_if
        else
            local dy2 = cy - tun_y_c
            if dy2 < 0.0 then
                dy2 = -dy2
            end_if
            if dy2 <= tun_BH then
                in_tun = 1
            end_if
        end_if
        if in_tun = 1 then
            zone.group(z) = 'tunnel'
            n_marked = n_marked + 1
        end_if
    end_loop
    ii = io.out('tunnel marked: ' + string(n_marked))
end
@mark_tunnel
